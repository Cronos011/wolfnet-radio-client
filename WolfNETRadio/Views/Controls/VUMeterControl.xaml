<UserControl x:Class="WolfNETRadio.Views.Controls.VUMeterControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="200"
             d:DesignHeight="16">

    <UserControl.Resources>
        <Style x:Key="VuProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource GreenActiveBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ProgressBar Style="{StaticResource VuProgressStyle}"
                     Minimum="0" Maximum="1"
                     Value="{Binding Level, ElementName=Root}" />
    </Grid>
</UserControl>
