<Window x:Class="WolfNETRadio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:WolfNETRadio.Views.Controls"
        mc:Ignorable="d"
        Title="WolfNET Radio"
        Icon="/Assets/wolfnet-radio.ico"
        Width="620" Height="700"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI"
        Background="{StaticResource BgDeepBrush}">

    <Window.Resources>
        <Style x:Key="OverlayToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#090E16" BorderBrush="#1E2A3A" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/wolfnet-logo.png" Width="36" Height="36" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WOLFNET RADIO" FontSize="16" FontWeight="Bold"
                                   Foreground="#D4A017" FontFamily="Segoe UI" />
                        <TextBlock Text="Voice comms — gwrecon.com:5002" FontSize="10"
                                   Foreground="#8A96A8" FontFamily="Segoe UI" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#FF4444" Margin="0,0,4,0" />
                    <TextBlock x:Name="ServerStatusText" Text="DISCONNECTED" FontSize="10"
                               Foreground="#8A96A8" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Ellipse x:Name="VoipStatusDot" Width="8" Height="8" Fill="#FF4444" Margin="0,0,4,0" />
                    <TextBlock x:Name="VoipStatusText" Text="VOIP" FontSize="10"
                               Foreground="#8A96A8" FontFamily="Consolas" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,16,16,16">

                <Border Background="#090E16" BorderBrush="#1E2A3A" BorderThickness="1" Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🔑  RADIO ACCESS KEY" FontSize="11" FontWeight="Bold"
                                   Foreground="#4FC3F7" FontFamily="Segoe UI" Margin="0,0,0,8" />
                        <TextBlock Text="Authenticates you with gwrecon.com. Get your key from gwrecon.com/comms." FontSize="11"
                                   Foreground="#8A96A8" FontFamily="Segoe UI" Margin="0,0,0,10" TextWrapping="Wrap" />

                        <TextBox x:Name="RadioAccessKeyBox"
                                 Background="#0C1119" Foreground="#4FC3F7" BorderBrush="#1E2A3A" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="12" Height="32" Padding="8,4"
                                 ToolTip="Paste your Radio Access Key here" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServerAddressBox" Grid.Column="0"
                                     Background="#0C1119" Foreground="#EDF2F8" BorderBrush="#1E2A3A" BorderThickness="1"
                                     FontFamily="Consolas" FontSize="11" Height="32" Padding="8,4"
                                     Text="gwrecon.com:5002" />
                            <Button x:Name="ConnectButton" Grid.Column="2"
                                    Content="CONNECT" Height="32"
                                    Background="#D4A017" Foreground="#05080C" BorderThickness="0"
                                    FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                    Click="ConnectButton_Click" />
                        </Grid>
                        <!-- Status message -->
                        <TextBlock x:Name="StatusLabel" Text="" FontFamily="Consolas" FontSize="10"
                                   Foreground="#8A96A8" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="#090E16" BorderBrush="#1E2A3A" BorderThickness="1" Margin="0,0,0,12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📡  OVERLAYS" FontSize="11" FontWeight="Bold"
                                       Foreground="#4FC3F7" FontFamily="Segoe UI" Margin="0,0,0,10" />
                            <ToggleButton x:Name="CommsArrayButton"
                                          Content="COMMS ARRAY" Height="40"
                                          Style="{StaticResource OverlayToggleStyle}"
                                          Checked="CommsArrayButton_Checked" Unchecked="CommsArrayButton_Unchecked"
                                          Margin="0,0,0,6" />
                            <ToggleButton x:Name="CommandCenterButton"
                                          Content="COMMAND CENTER" Height="40"
                                          Style="{StaticResource OverlayToggleStyle}"
                                          Checked="CommandCenterButton_Checked" Unchecked="CommandCenterButton_Unchecked" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="⚡  CONNECTION" FontSize="11" FontWeight="Bold"
                                       Foreground="#4FC3F7" FontFamily="Segoe UI" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server" FontSize="10" Foreground="#8A96A8" FontFamily="Segoe UI" Margin="0,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="gwrecon.com" FontSize="10" Foreground="#EDF2F8" FontFamily="Consolas" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" FontSize="10" Foreground="#8A96A8" FontFamily="Segoe UI" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="5002" FontSize="10" Foreground="#EDF2F8" FontFamily="Consolas" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Clients" FontSize="10" Foreground="#8A96A8" FontFamily="Segoe UI" Margin="0,2" />
                                <TextBlock x:Name="ClientCountText" Grid.Row="2" Grid.Column="1" Text="{Binding ConnectedClientCount}" FontSize="10" Foreground="#4FC3F7" FontFamily="Consolas" Margin="0,2" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Card: Server Presets ────────────────────────────── -->
                <Border Background="#090E16" BorderBrush="#1E2A3A" BorderThickness="1" Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📋  SERVER PRESETS" FontSize="11" FontWeight="Bold"
                                       Foreground="#4FC3F7" FontFamily="Segoe UI" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="LoadAllPresetsButton" Content="LOAD ALL →"
                                        Height="22" Padding="10,0" FontFamily="Consolas" FontSize="9" Margin="0,0,6,0"
                                        Background="#0C1119" Foreground="#43E59A" BorderBrush="#1E4A3A" BorderThickness="1"
                                        IsEnabled="False"
                                        Click="LoadAllPresets_Click" />
                                <Button x:Name="RefreshPresetsButton" Content="REFRESH"
                                        Height="22" Padding="10,0" FontFamily="Consolas" FontSize="9"
                                        Background="#0C1119" Foreground="#D4A017" BorderBrush="#1E2A3A" BorderThickness="1"
                                        Click="RefreshPresets_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Missions you are signed up for with radio channel assignments."
                                   FontSize="10" Foreground="#8A96A8" FontFamily="Segoe UI"
                                   Margin="0,6,0,8" TextWrapping="Wrap" />
                        <ComboBox x:Name="MissionPresetsCombo"
                                  Height="28" Background="#0C1119" Foreground="#EDF2F8"
                                  BorderBrush="#1E2A3A" FontFamily="Segoe UI" FontSize="11"
                                  SelectionChanged="MissionPresetsCombo_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#EDF2F8" />
                                    <Setter Property="Background" Value="#0C1119" />
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <ItemsControl x:Name="PresetChannelsList" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#090E16" BorderBrush="#1E2A3A" BorderThickness="1" Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🔊  AUDIO" FontSize="11" FontWeight="Bold"
                                   Foreground="#4FC3F7" FontFamily="Segoe UI" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Input" FontSize="11" Foreground="#8A96A8"
                                       FontFamily="Segoe UI" VerticalAlignment="Center" />
                            <ComboBox x:Name="InputDeviceCombo" Grid.Row="0" Grid.Column="1"
                                      Height="28" Background="#0C1119" Foreground="#EDF2F8"
                                      BorderBrush="#1E2A3A" FontFamily="Segoe UI" FontSize="11">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="#EDF2F8" />
                                        <Setter Property="Background" Value="#0C1119" />
                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Output" FontSize="11" Foreground="#8A96A8"
                                       FontFamily="Segoe UI" VerticalAlignment="Center" />
                            <ComboBox x:Name="OutputDeviceCombo" Grid.Row="2" Grid.Column="1"
                                      Height="28" Background="#0C1119" Foreground="#EDF2F8"
                                      BorderBrush="#1E2A3A" FontFamily="Segoe UI" FontSize="11">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="#EDF2F8" />
                                        <Setter Property="Background" Value="#0C1119" />
                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Level" FontSize="11" Foreground="#8A96A8"
                                       FontFamily="Segoe UI" VerticalAlignment="Center" />
                            <controls:VUMeterControl x:Name="VuMeter" Grid.Row="4" Grid.Column="1" Height="16" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#090E16" BorderBrush="#1E2A3A" BorderThickness="1" Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⌨  CONTROLS" FontSize="11" FontWeight="Bold"
                                   Foreground="#4FC3F7" FontFamily="Segoe UI" Margin="0,0,0,4" />
                        <TextBlock Text="Click SET then press a key to bind. Modifier is an optional hold key (e.g. Ctrl, Shift)."
                                   FontSize="10" Foreground="#8A96A8" FontFamily="Segoe UI" Margin="0,0,0,10" TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BINDING" FontSize="9" Foreground="#4A5568" FontFamily="Consolas" />
                            <TextBlock Grid.Column="1" Text="PRIMARY KEY" FontSize="9" Foreground="#4A5568" FontFamily="Consolas" />
                            <TextBlock Grid.Column="5" Text="MODIFIER" FontSize="9" Foreground="#4A5568" FontFamily="Consolas" />
                        </Grid>

                        <StackPanel x:Name="KeyBindingRows" />
                    </StackPanel>
                </Border>

                <!-- ── Card: Settings ─────────────────────────────────── -->
                <Border Background="#090E16" BorderBrush="#1E2A3A" BorderThickness="1" Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚙  SETTINGS" FontSize="11" FontWeight="Bold"
                                   Foreground="#4FC3F7" FontFamily="Segoe UI" Margin="0,0,0,10" />

                        <!-- Radio effects toggle -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Radio Effects" FontSize="11" Foreground="#EDF2F8" FontFamily="Segoe UI" />
                                <TextBlock Text="Applies distortion and static to received audio" FontSize="10"
                                           Foreground="#8A96A8" FontFamily="Segoe UI" />
                            </StackPanel>
                            <CheckBox x:Name="RadioEffectsCheck" Grid.Column="1" IsChecked="True"
                                      VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>

                        <!-- Speaker volume -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Speaker Volume" FontSize="11"
                                       Foreground="#8A96A8" FontFamily="Segoe UI" VerticalAlignment="Center" />
                            <Slider x:Name="SpeakerVolumeSlider" Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="100"
                                    Height="20" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Mic volume -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mic Boost" FontSize="11"
                                       Foreground="#8A96A8" FontFamily="Segoe UI" VerticalAlignment="Center" />
                            <Slider x:Name="MicBoostSlider" Grid.Column="1"
                                    Minimum="0" Maximum="200" Value="100"
                                    Height="20" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Start minimized -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Start minimized" FontSize="11"
                                       Foreground="#EDF2F8" FontFamily="Segoe UI" VerticalAlignment="Center" />
                            <CheckBox x:Name="StartMinimizedCheck" Grid.Column="1"
                                      VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>

                        <!-- Overlay always on top -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Overlays always on top" FontSize="11"
                                       Foreground="#EDF2F8" FontFamily="Segoe UI" VerticalAlignment="Center" />
                            <CheckBox x:Name="AlwaysOnTopCheck" Grid.Column="1" IsChecked="True"
                                      VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Card: About ───────────────────────────────────── -->
                <Border Background="#090E16" BorderBrush="#1E2A3A" BorderThickness="1" Margin="0,0,0,12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="WolfNET Radio" FontSize="13" FontWeight="Bold"
                                       Foreground="#D4A017" FontFamily="Segoe UI" />
                            <TextBlock Text="Luna Wolves Legion · gwrecon.com" FontSize="10"
                                       Foreground="#8A96A8" FontFamily="Segoe UI" Margin="0,2,0,0" />
                            <TextBlock Text="Star Citizen® is a trademark of Cloud Imperium Rights LLC"
                                       FontSize="9" Foreground="#4A5568" FontFamily="Segoe UI" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Image Grid.Column="1" Source="/Assets/wolfnet-logo.png"
                               Width="48" Height="48" Margin="12,0,0,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
