<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── WolfNET / gwrecon.com Palette ─────────────────────────────── -->

    <!-- Backgrounds -->
    <Color x:Key="BgDeepColor">#FF020508</Color>
    <Color x:Key="BgPanelColor">#FF030810</Color>
    <Color x:Key="BgInputColor">#FF0D1520</Color>
    <Color x:Key="BgHoverColor">#FF1A2535</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtleColor">#FF1A2535</Color>
    <Color x:Key="BorderMidColor">#FF2A3545</Color>
    <Color x:Key="BorderBrightColor">#FFD4A017</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFEDF2F8</Color>
    <Color x:Key="TextMutedColor">#FF8A96A8</Color>
    <Color x:Key="TextDimColor">#FF4A5568</Color>

    <!-- Accents -->
    <Color x:Key="GoldColor">#FFD4A017</Color>
    <Color x:Key="GoldLightColor">#FFE8B84B</Color>
    <Color x:Key="GoldDarkColor">#FFB8860B</Color>
    <Color x:Key="CyanColor">#FF4FC3F7</Color>
    <Color x:Key="CyanDimColor">#FF1E88B5</Color>
    <Color x:Key="GreenActiveColor">#FF43E59A</Color>
    <Color x:Key="RedDangerColor">#FFFF4444</Color>
    <Color x:Key="AmberColor">#FFFFA500</Color>

    <!-- ── Brushes ─────────────────────────────────────────────────── -->

    <SolidColorBrush x:Key="BgDeepBrush"     Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgPanelBrush"    Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgInputBrush"    Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BgHoverBrush"    Color="{StaticResource BgHoverColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderMidBrush"     Color="{StaticResource BorderMidColor}" />
    <SolidColorBrush x:Key="BorderBrightBrush"  Color="{StaticResource BorderBrightColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDimBrush"       Color="{StaticResource TextDimColor}" />

    <SolidColorBrush x:Key="GoldBrush"          Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldLightBrush"     Color="{StaticResource GoldLightColor}" />
    <SolidColorBrush x:Key="GoldDarkBrush"      Color="{StaticResource GoldDarkColor}" />
    <SolidColorBrush x:Key="CyanBrush"          Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="CyanDimBrush"       Color="{StaticResource CyanDimColor}" />
    <SolidColorBrush x:Key="GreenActiveBrush"   Color="{StaticResource GreenActiveColor}" />
    <SolidColorBrush x:Key="RedDangerBrush"     Color="{StaticResource RedDangerColor}" />
    <SolidColorBrush x:Key="AmberBrush"         Color="{StaticResource AmberColor}" />

    <SolidColorBrush x:Key="TransparentBrush"   Color="Transparent" />

</ResourceDictionary>
